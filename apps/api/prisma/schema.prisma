generator client {
  provider = "prisma-client-js"
}

// SQLite for local development. For PostgreSQL, change provider to "postgresql"
// and set DATABASE_URL accordingly (see .env.example).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum StockStatus {
  IN_STOCK
  ON_ORDER
  OUT_OF_STOCK
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONTACTED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  leads        Lead[]   @relation("AssignedLeads")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  filterSchema String?   // JSON: array of filter field keys for this category
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  promotions  Promotion[]
}

model Brand {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  logo        String?
  description String?
  website     String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  products    Product[]
  collections Collection[]
}

model Collection {
  id        String    @id @default(cuid())
  name      String
  slug      String
  brandId   String
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([brandId, slug])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  sku             String   @unique
  description     String?
  price           Float
  oldPrice        Float?
  discountPercent Float?
  unit            String   @default("м²")
  packQty         Float?
  packArea        Float?
  thickness       Float?
  wearClass       String?
  length          Float?
  width           Float?
  color           String?
  bevel           String?
  lockType        String?
  moistureResistant Boolean @default(false)
  underfloorHeating Boolean @default(false)
  wearLayer       String?
  seoTitle        String?
  seoDescription  String?
  published       Boolean  @default(true)
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  categoryId      String
  brandId         String
  collectionId    String?
  category        Category @relation(fields: [categoryId], references: [id])
  brand           Brand    @relation(fields: [brandId], references: [id])
  collection      Collection? @relation(fields: [collectionId], references: [id])
  images          ProductImage[]
  characteristics ProductCharacteristic[]
  stocks          Stock[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([published])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
  storageKey String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductCharacteristic {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
  @@index([key])
}

model CharacteristicDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  type      String   @default("text") // text | number | boolean | select
  options   String?  // JSON for select options
  unit      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  active Boolean @default(true)
  stores Store[]
  stocks Stock[]
  promotions Promotion[]
  leads  Lead[]
}

model Store {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String?
  schedule    String?
  description String?
  photos      String?  // JSON array of URLs
  lat         Float?
  lng         Float?
  active      Boolean  @default(true)
  cityId      String
  city        City     @relation(fields: [cityId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stock {
  id        String      @id @default(cuid())
  productId String
  cityId    String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  city      City        @relation(fields: [cityId], references: [id])
  status    StockStatus @default(IN_STOCK)
  quantity  Float       @default(0)
  updatedAt DateTime    @updatedAt

  @@unique([productId, cityId])
}

model Promotion {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?
  image           String?
  discountPercent Float?
  startsAt        DateTime?
  endsAt          DateTime?
  productIds      String?   // JSON array
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  cityId          String?
  city            City?     @relation(fields: [cityId], references: [id])
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Work {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  image       String?
  city        String?
  category    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  comment      String?
  source       String?
  status       LeadStatus @default(NEW)
  cityId       String?
  city         City?      @relation(fields: [cityId], references: [id])
  assignedToId String?
  assignedTo   User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  meta         String?    // JSON extra
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String?
  body      String?  // JSON or markdown
  image     String?
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  ctaText   String?
  ctaLink   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Advantage {
  id          String  @id @default(cuid())
  title       String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

model ContactInfo {
  id      String  @id @default(cuid())
  key     String  @unique
  label   String
  value   String
  active  Boolean @default(true)
}
